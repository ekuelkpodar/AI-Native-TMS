# Copy to .env and fill in values. Never commit a real .env with secrets.
# Backend
DATABASE_URL=sqlite:///./tms.db
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
AI_PROVIDER=mock
OPENAI_API_KEY=
